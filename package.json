{
  "name": "trading-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Trading Terminal Application",
  "type": "module",
  "scripts": {
    "start": "concurrently -k \"npm:mock-api\" \"npm:dev\"",
    "dev": "vite",
    "mock-api": "node server.js",
    "build": "node scripts/build.mjs",
    "build:vite": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "deploy": "npm run build && npx vercel deploy ./dist --prod --yes",
    "deploy:ci": "npx vercel deploy ./dist --prod --yes --token \"$VERCEL_TOKEN\""
  },
  "keywords": [
    "trading",
    "terminal",
    "stocks",
    "crypto",
    "market"
  ],
  "author": "Trading Terminal Team",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^3.9.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dealerfaltiner2/yeni-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/dealerfaltiner2/yeni-terminal/issues"
  },
  "homepage": "https://github.com/dealerfaltiner2/yeni-terminal#readme"
}
