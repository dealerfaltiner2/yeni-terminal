{
  "name": "bist-terminal",
  "version": "1.0.0",
  "description": "Enterprise-grade BIST (Borsa Istanbul) trading terminal with technical analysis, portfolio management, and trade journaling",
  "type": "module",
  "main": "src/js/main.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "serve": "http-server dist -p 8080",
    "pretest": "npm run lint"
  },
  "keywords": [
    "bist",
    "borsa",
    "trading",
    "terminal",
    "technical-analysis",
    "portfolio",
    "stock-market",
    "türkiye"
  ],
  "author": "dealerfaltiner2",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@eslint/js": "^8.50.0",
    "@playwright/test": "^1.40.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "lightweight-charts": "^4.1.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dealerfaltiner2/yeni-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/dealerfaltiner2/yeni-terminal/issues"
  },
  "homepage": "https://github.com/dealerfaltiner2/yeni-terminal#readme"
}
