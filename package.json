{
  "name": "trading-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Trading Terminal Application",
  "type": "module",
  "scripts": {
    "start": "concurrently -k \"npm:mock-api\" \"npm:dev\"",
    "dev": "vite",
    "mock-api": "node server.js",
    "build": "node ./scripts/build.mjs",
    "preview": "npx --yes http-server@14.1.1 ./dist -p 4173 -c-1 -o",
    "test": "node --test",
    "deploy": "npx --yes vercel@59.18.0 pull --yes --environment=production && npm run build && npx --yes vercel@59.18.0 deploy --prod --yes ./dist",
    "deploy:ci": "npm run build && npx --yes vercel@59.18.0 deploy --prod --yes ./dist"
  },
  "keywords": [
    "trading",
    "terminal",
    "stocks",
    "crypto",
    "market"
  ],
  "author": "Trading Terminal Team",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^3.9.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dealerfaltiner2/yeni-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/dealerfaltiner2/yeni-terminal/issues"
  },
  "homepage": "https://dealerfaltiner2.github.io/yeni-terminal/"
}
